APP_ENV=simulation
DEPLOYMENT_PROFILE=test_iteration
MAINNET_ENABLED=false
DB_PROVIDER=supabase
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_TLS_CA_PEM=
CACHE_PROVIDER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_PROVIDER=simulation
PAYMENT_PROVIDER=giv_simulation
WALLET_PROVIDER=dummy
SIGNER_PROVIDER=disabled
OPERATIONAL_RETENTION_HOLD=false
CAPTCHA_PROVIDER=dummy
REALTIME_PROVIDER=none
PRICE_PROVIDER=manual_simulation
ALERT_PROVIDER=none
WEB_ORIGIN=

SCHEDULER_HMAC_KEY=
SCHEDULER_HMAC_PREVIOUS_KEY=

# Maintenance-only simulation recovery. Keep the key outside Vercel.
EXPORT_ENCRYPTION_KEY=
RECOVERY_CONFIRM=
RECOVERY_RESTORE_CONFIRM=

# Server-only identity keys. Generate independently; never expose in the manifest.
AUTH_ACCESS_KEY=
AUTH_ACCESS_PREVIOUS_KEY=
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Disposable operator scenarios only; prohibited in Vercel.
SIMULATION_TOOL_AUTH_KEY=

# Separate server-only own-export encryption; never reuse the native backup key.
DATA_EXPORT_KEY=

# Verified testnet adapters remain disabled until independently reviewed.
ASSET_REGISTRY_FILE=
FINANCIAL_ACTIVATION=
FINANCIAL_CONFIG_APPROVAL=
ALERT_ACCEPTANCE_FINGERPRINT=
FINANCIAL_WORKER_AUTH_KEY=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KEY=
# Worker-only settings: never provision these in web/Vercel.
SIGNER_DATABASE_URL=
SIGNER_KEY_FILE=
SIGNER_DECRYPTION_SECRET=
SIGNED_PAYLOAD_ENCRYPTION_KEY=

FINANCIAL_API_ORIGIN=

PRICE_FEED_PUBLIC_KEY=

# Server-only bot-check bindings. Only the public site key is projected to widgets.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Optional owner-produced encrypted portability artifact and private staging.
# Keep unconfigured until an operator supplies a version-matching archive.
SITE_BACKUP_FILE=
SITE_BACKUP_SHA256=
SITE_IMPORT_STAGING_DIR=
