{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@gifters/domain": [
        "packages/domain/src/index.ts"
      ],
      "@gifters/config": [
        "packages/config/src/index.ts"
      ],
      "@gifters/db": [
        "packages/db/src/index.ts"
      ],
      "@gifters/cache": [
        "packages/cache/src/index.ts"
      ],
      "@gifters/chains": [
        "packages/chains/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "server/**/*.ts",
    "packages/**/*.ts",
    "drizzle.config.ts",
    ".next/dev/types/**/*.ts",
    "workers/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
